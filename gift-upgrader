<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Gift Upgrader</title>
<style>
  :root {
    --bg: #07060f; --panel: #151230; --panel-2: #1c1840;
    --line: rgba(255,255,255,.08); --text: #f2f0ff; --muted: #8f8ab3;
    --cyan: #19f0ff; --magenta: #ff2bd6; --violet: #8a4dff;
    --gold: #ffc83d; --green: #2dff9a; --red: #ff4466;
    --font: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
    --card-w: 96px; --card-gap: 8px;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font-family: var(--font); overscroll-behavior: none; }
  body {
    background:
      radial-gradient(900px 500px at 15% -10%, rgba(138,77,255,.25), transparent 60%),
      radial-gradient(700px 500px at 100% 10%, rgba(25,240,255,.14), transparent 60%),
      radial-gradient(800px 600px at 50% 120%, rgba(255,43,214,.16), transparent 60%),
      #07060f;
    overflow-x: hidden; user-select: none; -webkit-user-select: none;
  }
  button { font-family: inherit; color: inherit; border: 0; background: none; cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
  img { -webkit-user-drag: none; }

  .app { min-height: 100%; display: flex; flex-direction: column; padding: calc(env(safe-area-inset-top) + 10px) 14px calc(env(safe-area-inset-bottom) + 16px); max-width: 560px; margin: 0 auto; }

  /* ---------- Top bar ---------- */
  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .user { display: flex; align-items: center; gap: 10px; padding: 5px 14px 5px 5px; border-radius: 999px; background: linear-gradient(180deg, var(--panel-2), var(--panel)); border: 1px solid var(--line); min-width: 0; transition: box-shadow .25s, border-color .25s; }
  .user:hover { border-color: rgba(25,240,255,.5); box-shadow: 0 0 18px rgba(25,240,255,.25); }
  .avatar { width: 38px; height: 38px; border-radius: 50%; flex: none; display: grid; place-items: center; font-weight: 800; background: linear-gradient(135deg, var(--violet), var(--magenta)); box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--cyan), 0 0 14px rgba(25,240,255,.5); overflow: hidden; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .uname { font-weight: 700; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 130px; }
  .balance { display: flex; align-items: center; gap: 6px; padding: 5px 5px 5px 14px; border-radius: 999px; background: linear-gradient(180deg, var(--panel-2), var(--panel)); border: 1px solid var(--line); font-weight: 800; font-size: 16px; }
  .balance .val { color: var(--gold); text-shadow: 0 0 12px rgba(255,200,61,.55); transition: transform .3s; display: inline-block; }
  .balance .val.bump { transform: scale(1.25); }
  .plus { width: 32px; height: 32px; border-radius: 50%; font-size: 22px; line-height: 1; font-weight: 800; display: grid; place-items: center; background: linear-gradient(135deg, var(--cyan), var(--violet)); color: #07060f; box-shadow: 0 0 16px rgba(25,240,255,.6); transition: transform .2s, box-shadow .2s; }
  .plus:active { transform: scale(.9); }

  /* ---------- Title ---------- */
  .title { text-align: center; margin: 14px 0 6px; }
  .title h1 { margin: 0; font-weight: 800; font-size: 26px; letter-spacing: 1px; color: var(--cyan); background: linear-gradient(90deg, var(--cyan), var(--violet) 50%, var(--magenta)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 0 14px rgba(138,77,255,.5)); }

  /* ---------- Upgrade circle ---------- */
  .circle-wrap { display: flex; flex-direction: column; align-items: center; margin: 4px 0 14px; }
  .circle { position: relative; width: 210px; height: 210px; }
  .circle svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; }
  .ring-track { fill: none; stroke: rgba(255,255,255,.08); stroke-width: 12; }
  .ring-fill { fill: none; stroke: url(#ringGrad); stroke-width: 12; stroke-linecap: round; transition: stroke-dasharray .6s cubic-bezier(.2,.8,.2,1); filter: drop-shadow(0 0 8px rgba(45,255,154,.7)); }
  .circle.spinning .ring-fill { animation: pulse 1s ease-in-out infinite; }
  @keyframes pulse { 50% { filter: drop-shadow(0 0 18px rgba(255,43,214,.95)); } }
  .circle-core { position: absolute; inset: 22px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: radial-gradient(circle at 50% 35%, rgba(138,77,255,.35), #100d26 70%); border: 1px solid rgba(138,77,255,.45); box-shadow: 0 0 30px rgba(138,77,255,.35) inset; padding: 8px; }
  .circle-core img { width: 76px; height: 76px; object-fit: contain; filter: drop-shadow(0 4px 10px rgba(0,0,0,.6)); transition: transform .4s; }
  .circle.spinning .circle-core img { animation: wobble 1.2s ease-in-out infinite; }
  @keyframes wobble { 0%,100% { transform: rotate(-6deg) scale(1); } 50% { transform: rotate(6deg) scale(1.08); } }
  .core-name { font-weight: 700; font-size: 13px; margin-top: 2px; max-width: 120px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .core-chance { font-weight: 800; font-size: 20px; color: var(--green); text-shadow: 0 0 10px rgba(45,255,154,.5); line-height: 1.1; }
  .core-empty { color: var(--muted); font-size: 13px; padding: 0 10px; line-height: 1.3; }
  .core-hint { font-size: 11px; color: var(--muted); }
  .upgrade-line { margin-top: 10px; display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); min-height: 36px; }
  .upgrade-line img { width: 34px; height: 34px; object-fit: contain; }
  .upgrade-line b { color: var(--text); }
  .upgrade-line .arrow { color: var(--cyan); font-size: 18px; text-shadow: 0 0 10px var(--cyan); }

  /* ---------- Roulette ---------- */
  .roulette { position: relative; border-radius: 18px; padding: 14px 0; background: linear-gradient(180deg, #0c0a1d, #120e2b); border: 1px solid rgba(138,77,255,.35); box-shadow: 0 0 0 1px rgba(0,0,0,.6) inset, 0 0 32px rgba(138,77,255,.25), 0 18px 40px rgba(0,0,0,.5); overflow: hidden; }
  .roulette::before, .roulette::after { content: ""; position: absolute; top: 0; bottom: 0; width: 70px; z-index: 3; pointer-events: none; }
  .roulette::before { left: 0; background: linear-gradient(90deg, #0b091a, rgba(11,9,26,0)); }
  .roulette::after { right: 0; background: linear-gradient(270deg, #0b091a, rgba(11,9,26,0)); }
  .viewport { overflow: hidden; }
  .strip { display: flex; gap: var(--card-gap); will-change: transform; transform: translateX(0); }
  .rcard { position: relative; flex: none; width: var(--card-w); height: 124px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: linear-gradient(180deg, var(--c22), #100d26 75%); border: 1px solid var(--c55); box-shadow: 0 -3px 0 var(--c) inset; transition: transform .4s, filter .4s, opacity .4s; }
  .rcard img { width: 60px; height: 60px; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(0,0,0,.5)); }
  .rcard .n { font-size: 12px; font-weight: 700; margin-top: 2px; }
  .rcard .p { font-size: 11px; color: var(--gold); font-weight: 700; }
  .strip.done .rcard:not(.winner) { opacity: .35; filter: saturate(.5); }
  .rcard.winner { transform: scale(1.08); box-shadow: 0 -3px 0 var(--c) inset, 0 0 26px var(--c); z-index: 2; }
  .marker { position: absolute; left: 50%; top: 0; bottom: 0; width: 3px; margin-left: -1.5px; z-index: 4; background: linear-gradient(180deg, var(--cyan), var(--magenta)); box-shadow: 0 0 14px var(--cyan), 0 0 28px rgba(25,240,255,.6); pointer-events: none; }
  .marker::before, .marker::after { content: ""; position: absolute; left: 50%; margin-left: -8px; border-left: 8px solid transparent; border-right: 8px solid transparent; }
  .marker::before { top: 0; border-top: 11px solid var(--cyan); }
  .marker::after { bottom: 0; border-bottom: 11px solid var(--magenta); }

  /* ---------- Pickers ---------- */
  .picker { margin-top: 14px; }
  .picker h3 { margin: 0 0 6px 2px; font-weight: 700; font-size: 14px; color: var(--muted); }
  .row { display: flex; gap: 8px; overflow-x: auto; padding: 6px 2px 10px; scrollbar-width: none; }
  .row::-webkit-scrollbar { display: none; }
  .chip { position: relative; flex: none; width: 88px; padding: 8px 4px 7px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; gap: 3px; background: linear-gradient(180deg, var(--panel-2), var(--panel)); border: 1px solid var(--line); transition: transform .2s, box-shadow .25s, border-color .25s, opacity .25s; }
  .chip img { width: 44px; height: 44px; object-fit: contain; }
  .chip .n { font-size: 12px; font-weight: 700; }
  .chip .p { font-size: 11px; color: var(--gold); font-weight: 700; }
  .chip .tag { position: absolute; top: -6px; right: -4px; padding: 1px 6px; border-radius: 99px; font-size: 10px; font-weight: 800; color: #07060f; background: var(--cyan); box-shadow: 0 0 10px rgba(25,240,255,.7); }
  .chip .tag.st { background: var(--gold); box-shadow: 0 0 10px rgba(255,200,61,.6); }
  .chip.sel { border-color: var(--c); box-shadow: 0 0 0 1px var(--c), 0 0 18px var(--c70); transform: translateY(-2px); }
  .chip:disabled { opacity: .3; cursor: not-allowed; }
  .chip:not(:disabled):active { transform: scale(.95); }
  .empty-note { color: var(--muted); font-size: 13px; padding: 10px 2px; }

  /* ---------- Spin ---------- */
  .spacer { flex: 1; min-height: 8px; }
  .spin { width: 100%; margin-top: 8px; padding: 16px 20px; border-radius: 16px; font-weight: 800; font-size: 20px; letter-spacing: 1px; color: #07060f; background: linear-gradient(100deg, var(--cyan), var(--violet) 55%, var(--magenta)); background-size: 160% 100%; box-shadow: 0 0 22px rgba(138,77,255,.7), 0 0 50px rgba(255,43,214,.35), 0 -2px 0 rgba(255,255,255,.35) inset; transition: transform .15s, filter .2s, background-position .6s; }
  .spin small { display: block; font-size: 12px; font-weight: 700; opacity: .75; letter-spacing: 0; margin-top: 1px; }
  .spin:hover { background-position: 100% 0; }
  .spin:active { transform: scale(.98); }
  .spin:disabled { filter: grayscale(.9) brightness(.55); box-shadow: none; cursor: not-allowed; }

  /* ---------- Modals ---------- */
  .overlay { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 20px; background: rgba(4,3,12,.78); opacity: 0; pointer-events: none; transition: opacity .25s; }
  .overlay.open { opacity: 1; pointer-events: auto; }
  .modal { width: 100%; max-width: 380px; max-height: 92vh; overflow-y: auto; border-radius: 22px; padding: 22px 20px 20px; background: linear-gradient(180deg, #1d1845, #120f2b); border: 1px solid rgba(138,77,255,.45); box-shadow: 0 0 40px rgba(138,77,255,.35), 0 30px 60px rgba(0,0,0,.6); transform: translateY(20px) scale(.95); transition: transform .3s cubic-bezier(.2,.9,.3,1.2); position: relative; }
  .overlay.open .modal { transform: none; }
  .modal h2 { margin: 0 0 14px; font-size: 21px; text-align: center; }
  .close { position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,.07); font-size: 16px; line-height: 1; }

  .profile-head { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-bottom: 16px; }
  .profile-head .avatar { width: 84px; height: 84px; font-size: 30px; }
  .profile-head .nm { font-weight: 800; font-size: 20px; }
  .stat { display: flex; justify-content: space-between; align-items: center; padding: 13px 14px; border-radius: 12px; background: rgba(255,255,255,.05); border: 1px solid var(--line); margin-top: 8px; font-size: 15px; }
  .stat span:first-child { color: var(--muted); }
  .stat b { font-size: 17px; }
  .stat b.gold { color: var(--gold); text-shadow: 0 0 10px rgba(255,200,61,.5); }

  .method { padding: 16px; border-radius: 16px; margin-top: 10px; background: rgba(255,255,255,.04); border: 1px solid var(--line); }
  .method.stars { border-color: rgba(255,200,61,.4); }
  .method.nft { border-color: rgba(25,240,255,.4); }
  .method h4 { margin: 0 0 4px; font-size: 17px; }
  .method p { margin: 0 0 12px; font-size: 13px; color: var(--muted); line-height: 1.4; }
  .amounts { display: flex; gap: 8px; margin-bottom: 12px; }
  .amt { flex: 1; padding: 9px 0; border-radius: 10px; font-weight: 800; font-size: 15px; background: rgba(255,255,255,.06); border: 1px solid var(--line); transition: all .2s; }
  .amt.sel { background: rgba(255,200,61,.14); border-color: var(--gold); color: var(--gold); box-shadow: 0 0 14px rgba(255,200,61,.4); }
  .btn { width: 100%; padding: 14px; border-radius: 13px; font-weight: 800; font-size: 16px; color: #07060f; transition: transform .15s; }
  .btn:active { transform: scale(.98); }
  .btn.gold { background: linear-gradient(100deg, #ffe27a, var(--gold) 50%, #ff9a3d); box-shadow: 0 0 20px rgba(255,200,61,.55); }
  .btn.cyan { background: linear-gradient(100deg, var(--cyan), #5a8dff); box-shadow: 0 0 20px rgba(25,240,255,.5); }
  .btn.violet { background: linear-gradient(100deg, var(--violet), var(--magenta)); color: #fff; box-shadow: 0 0 20px rgba(138,77,255,.6); }

  .result { text-align: center; }
  .result .big { font-weight: 800; font-size: 32px; margin: 4px 0 2px; }
  .result.win .big { color: var(--green); text-shadow: 0 0 22px rgba(45,255,154,.7); }
  .result.lose .big { color: var(--red); text-shadow: 0 0 22px rgba(255,68,102,.6); }
  .result img { width: 96px; height: 96px; object-fit: contain; margin: 8px 0; animation: pop .6s cubic-bezier(.2,.9,.3,1.4); }
  .result .sub { color: var(--muted); font-size: 14px; margin-bottom: 16px; min-height: 20px; }
  @keyframes pop { from { transform: scale(.3) rotate(-12deg); opacity: 0; } to { transform: none; opacity: 1; } }

  .toast { position: fixed; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 90px); transform: translate(-50%, 20px); z-index: 80; padding: 11px 18px; border-radius: 12px; font-size: 14px; background: #2a1a3d; border: 1px solid var(--magenta); box-shadow: 0 0 20px rgba(255,43,214,.45); opacity: 0; pointer-events: none; transition: all .3s; max-width: 90vw; text-align: center; }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }

  @media (prefers-reduced-motion: reduce) { * { transition-duration: .01ms !important; animation-duration: .01ms !important; } }
</style>
</head>
<body>
<div class="app">

  <header class="topbar">
    <button class="user" id="userBtn" aria-label="Открыть профиль">
      <span class="avatar" id="avatar">?</span>
      <span class="uname" id="uname">Игрок</span>
    </button>
    <div class="balance">
      <span>⭐</span><span class="val" id="balance">150</span>
      <button class="plus" id="plusBtn" aria-label="Пополнить">+</button>
    </div>
  </header>

  <div class="title"><h1>GIFT UPGRADER</h1></div>

  <!-- Круг апгрейда: внутри — подарок, который апгрейдим -->
  <div class="circle-wrap">
    <div class="circle" id="circle">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff4466"/>
            <stop offset=".5" stop-color="#ffc83d"/>
            <stop offset="1" stop-color="#2dff9a"/>
          </linearGradient>
        </defs>
        <circle class="ring-track" cx="100" cy="100" r="92"/>
        <circle class="ring-fill" id="ringFill" cx="100" cy="100" r="92" stroke-dasharray="0 578"/>
      </svg>
      <div class="circle-core" id="core"></div>
    </div>
    <div class="upgrade-line" id="upLine"></div>
  </div>

  <!-- Рулетка -->
  <section class="roulette" aria-label="Рулетка">
    <div class="marker"></div>
    <div class="viewport" id="viewport"><div class="strip" id="strip"></div></div>
  </section>

  <section class="picker">
    <h3>Что апгрейдим</h3>
    <div class="row" id="stakeRow"></div>
  </section>
  <section class="picker">
    <h3>Хочу получить</h3>
    <div class="row" id="targetRow"></div>
  </section>

  <div class="spacer"></div>
  <button class="spin" id="spinBtn" disabled>Крутить<small id="spinSub">Выбери подарок</small></button>
</div>

<!-- Профиль -->
<div class="overlay" id="profileModal">
  <div class="modal">
    <button class="close" data-close aria-label="Закрыть">✕</button>
    <div class="profile-head">
      <div class="avatar" id="pAvatar">?</div>
      <div class="nm" id="pName">Игрок</div>
    </div>
    <div class="stat"><span>ID</span><b id="pId">—</b></div>
    <div class="stat"><span>Баланс</span><b class="gold" id="pBalance">⭐ 150</b></div>
    <div class="stat"><span>Подарков в инвентаре</span><b id="pInv">0</b></div>
  </div>
</div>

<!-- Пополнение -->
<div class="overlay" id="topupModal">
  <div class="modal">
    <button class="close" data-close aria-label="Закрыть">✕</button>
    <h2>Пополнить баланс</h2>
    <div class="method stars">
      <h4>⭐ Telegram Stars</h4>
      <p>Оплата звёздами прямо в Telegram. Зачисление сразу после оплаты.</p>
      <div class="amounts" id="amounts">
        <button class="amt sel" data-amt="50">50</button>
        <button class="amt" data-amt="100">100</button>
        <button class="amt" data-amt="250">250</button>
      </div>
      <button class="btn gold" id="topupStars">Пополнить Stars</button>
    </div>
    <div class="method nft">
      <h4>🎁 NFT-подарок</h4>
      <p>Отправь подарок боту. Он появится здесь, и его можно будет апгрейдить.</p>
      <button class="btn cyan" id="topupNft">Пополнить подарком</button>
    </div>
  </div>
</div>

<!-- Результат -->
<div class="overlay" id="resultModal">
  <div class="modal result" id="resultBox">
    <div class="big" id="resTitle"></div>
    <img id="resImg" alt="">
    <div class="sub" id="resSub"></div>
    <button class="btn violet" id="resClose">Продолжить</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ================= Картинки-заглушки (не требуют интернета) =================
   Чтобы поставить настоящие картинки — замени ph(...) на обычный URL:
   image: 'https://site.com/bear.png'                                          */
function ph(label, c1, c2) {
  const svg =
    '<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100">' +
    '<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="' + c1 + '"/><stop offset="1" stop-color="' + c2 + '"/></linearGradient></defs>' +
    '<rect x="4" y="4" width="92" height="92" rx="22" fill="#2d2d2d"/>' +
    '<rect x="4" y="4" width="92" height="92" rx="22" fill="url(#g)" opacity=".35"/>' +
    '<rect x="4" y="4" width="92" height="92" rx="22" fill="none" stroke="' + c1 + '" stroke-width="3"/>' +
    '<text x="50" y="58" font-size="20" font-weight="700" font-family="Arial,sans-serif" text-anchor="middle" fill="#fff">' + label + '</text></svg>';
  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
}
const FALLBACK_IMG = ph('?', '#888', '#444');

/* ================= Подарки ================= */
const gifts = [
  { name: 'Мишка',    price: 15,  image: ph('Bear',  '#4b7bff', '#19f0ff') },
  { name: 'Сердечко', price: 50,  image: ph('Heart', '#8a4dff', '#ff2bd6') },
  { name: 'Кольцо',   price: 100, image: ph('Ring',  '#e23cf0', '#ff4466') },
  { name: 'Корона',   price: 500, image: ph('Crown', '#ffc83d', '#ff9a3d') }
];

// Если реальный URL не загрузился — подставляем заглушку
document.addEventListener('error', function (e) {
  const t = e.target;
  if (t && t.tagName === 'IMG' && t.src !== FALLBACK_IMG) {
    const g = gifts.find(x => x.image === t.getAttribute('data-src'));
    t.src = FALLBACK_IMG;
  }
}, true);

function hexToRgba(hex, a) {
  const n = parseInt(hex.slice(1), 16);
  return 'rgba(' + (n >> 16 & 255) + ',' + (n >> 8 & 255) + ',' + (n & 255) + ',' + a + ')';
}
function rarity(price) {
  if (price < 30)  return '#4b7bff';
  if (price < 80)  return '#8a4dff';
  if (price < 200) return '#e23cf0';
  return '#ffc83d';
}
function colorVars(price) {
  const c = rarity(price);
  return '--c:' + c + ';--c22:' + hexToRgba(c, .22) + ';--c55:' + hexToRgba(c, .55) + ';--c70:' + hexToRgba(c, .7);
}
const esc = (s) => String(s).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
const $ = (id) => document.getElementById(id);

/* ================= Telegram (безопасная инициализация) ================= */
let tg = null;
function initTelegram() {
  if (tg || !(window.Telegram && window.Telegram.WebApp)) return;
  tg = window.Telegram.WebApp;
  try { tg.ready(); tg.expand(); tg.setHeaderColor('#07060f'); tg.setBackgroundColor('#07060f'); } catch (e) {}
  loadUser();
  loadInventory();
  renderAll();
}
initTelegram();
// Скрипт Telegram подключается ПОСЛЕ загрузки страницы: даже если telegram.org
// недоступен или медленный, интерфейс уже нарисован и не «висит на загрузке».
function loadTelegramScript() {
  const s = document.createElement('script');
  s.src = 'https://telegram.org/js/telegram-web-app.js';
  s.onload = initTelegram;
  document.head.appendChild(s);
}
if (document.readyState === 'complete') loadTelegramScript();
else window.addEventListener('load', loadTelegramScript);

function haptic(type, style) {
  try {
    if (!tg || !tg.HapticFeedback) return;
    type === 'impact' ? tg.HapticFeedback.impactOccurred(style || 'light') : tg.HapticFeedback.notificationOccurred(style);
  } catch (e) {}
}
function sendToBot(payload) {
  console.log('sendData', payload);
  try { if (tg) tg.sendData(JSON.stringify(payload)); } catch (e) {}
}
function closeApp() { try { if (tg) tg.close(); } catch (e) {} }

/* ================= Пользователь ================= */
let user = { id: 123456789, first_name: 'Игрок' };
function loadUser() {
  const u = tg && tg.initDataUnsafe && tg.initDataUnsafe.user;
  if (u) user = u;
  const fullName = [user.first_name, user.last_name].filter(Boolean).join(' ') || 'Игрок';
  [$('avatar'), $('pAvatar')].forEach(el => {
    el.innerHTML = '';
    if (user.photo_url) {
      const img = document.createElement('img');
      img.alt = '';
      img.onerror = () => { el.textContent = fullName[0].toUpperCase(); };
      img.src = user.photo_url;
      el.appendChild(img);
    } else {
      el.textContent = fullName[0].toUpperCase();
    }
  });
  $('uname').textContent = user.first_name || fullName;
  $('pName').textContent = fullName;
  $('pId').textContent = user.id;
}

/* ================= Состояние ================= */
const state = { balance: 150, inventory: [], stakeKey: null, target: null, spinning: false };
let uidCounter = 1;

/* Инвентарь (NFT, которые пользователь внёс в бота).
   Бот открывает мини-апп со ссылкой вида:
     https://your.site/index.html?inv=<URL-encoded JSON>
   или передаёт то же самое в startapp (base64url JSON).
   Формат: [{"name":"Мишка"}, {"name":"Кольцо","price":100,"image":"https://..."}]   */
function parseInvParam(raw) {
  if (!raw) return null;
  const tryParse = (s) => { try { const v = JSON.parse(s); return Array.isArray(v) ? v : null; } catch (e) { return null; } };
  let v = tryParse(raw);
  if (v) return v;
  try { v = tryParse(decodeURIComponent(raw)); if (v) return v; } catch (e) {}
  try {
    const b64 = raw.replace(/-/g, '+').replace(/_/g, '/');
    v = tryParse(decodeURIComponent(escape(atob(b64))));
    if (v) return v;
  } catch (e) {}
  return null;
}
function loadInventory() {
  const q = new URLSearchParams(location.search);
  let list = parseInvParam(q.get('inv'));
  if (!list && tg && tg.initDataUnsafe && tg.initDataUnsafe.start_param) list = parseInvParam(tg.initDataUnsafe.start_param);
  const inTg = location.hash.indexOf('tgWebAppData') !== -1 || !!(window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initData);
  if (!list) list = inTg ? [] : [{ name: 'Мишка' }, { name: 'Кольцо' }]; // демо вне Telegram
  state.inventory = list.map(it => {
    const base = gifts.find(g => g.name === it.name) || {};
    return {
      uid: uidCounter++,
      gift: {
        name: it.name || base.name || 'Подарок',
        price: Number(it.price || base.price || 10),
        image: it.image || base.image || FALLBACK_IMG
      }
    };
  });
  state.stakeKey = null;
  state.target = null;
}

/* Ставка: либо подарок из инвентаря (inv:uid), либо подарок за звёзды (cat:index) */
function getStake() {
  if (!state.stakeKey) return null;
  if (state.stakeKey.indexOf('inv:') === 0) {
    const it = state.inventory.find(x => 'inv:' + x.uid === state.stakeKey);
    return it ? { src: 'nft', gift: it.gift, uid: it.uid } : null;
  }
  const g = gifts[+state.stakeKey.slice(4)];
  return g ? { src: 'stars', gift: g } : null;
}
function ensureSelection() {
  if (!getStake()) {
    state.stakeKey = state.inventory.length ? 'inv:' + state.inventory[0].uid : 'cat:0';
  }
  const s = getStake();
  if (state.target === null || gifts[state.target].price <= s.gift.price) {
    const next = gifts.findIndex(g => g.price > s.gift.price);
    state.target = next === -1 ? null : next;
  }
}

/* ================= Рендер ================= */
function renderBalance(bump) {
  $('balance').textContent = state.balance;
  $('pBalance').textContent = '⭐ ' + state.balance;
  $('pInv').textContent = state.inventory.length;
  if (bump) {
    $('balance').classList.add('bump');
    setTimeout(() => $('balance').classList.remove('bump'), 300);
  }
}
function chipHTML(g, key, selected, disabled, tag) {
  return '<button class="chip' + (selected ? ' sel' : '') + '" style="' + colorVars(g.price) + '" data-key="' + key + '"' + (disabled ? ' disabled' : '') + '>' +
    (tag ? '<span class="tag' + (tag === 'NFT' ? '' : ' st') + '">' + tag + '</span>' : '') +
    '<img src="' + g.image + '" alt="' + esc(g.name) + '">' +
    '<span class="n">' + esc(g.name) + '</span>' +
    '<span class="p">⭐ ' + g.price + '</span></button>';
}
function renderPickers() {
  ensureSelection();
  const s = getStake();
  let html = state.inventory.map(it => chipHTML(it.gift, 'inv:' + it.uid, state.stakeKey === 'inv:' + it.uid, state.spinning, 'NFT')).join('');
  html += gifts.map((g, i) => chipHTML(g, 'cat:' + i, state.stakeKey === 'cat:' + i, state.spinning, '⭐')).join('');
  $('stakeRow').innerHTML = html;
  $('stakeRow').querySelectorAll('.chip').forEach(b => b.onclick = () => selectStake(b.dataset.key));

  $('targetRow').innerHTML = gifts.map((g, i) => chipHTML(g, 't:' + i, i === state.target, state.spinning || g.price <= s.gift.price, '')).join('');
  $('targetRow').querySelectorAll('.chip').forEach(b => b.onclick = () => selectTarget(+b.dataset.key.slice(2)));
}
function getChance() {
  const s = getStake();
  if (!s || state.target === null) return null;
  return Math.min(95, Math.max(1, s.gift.price / gifts[state.target].price * 100 * 0.95));
}
function renderCircle() {
  const s = getStake(), c = getChance();
  const C = 2 * Math.PI * 92;
  $('ringFill').setAttribute('stroke-dasharray', (c === null ? 0 : c / 100 * C) + ' ' + C);
  const core = $('core');
  if (!s) {
    core.innerHTML = '<div class="core-empty">Выбери подарок для апгрейда</div>';
  } else {
    core.innerHTML = '<img src="' + s.gift.image + '" alt="' + esc(s.gift.name) + '">' +
      '<div class="core-name">' + esc(s.gift.name) + '</div>' +
      '<div class="core-chance">' + (c === null ? '—' : c.toFixed(1) + '%') + '</div>' +
      '<div class="core-hint">' + (s.src === 'nft' ? 'твой NFT' : 'за ⭐ ' + s.gift.price) + '</div>';
  }
  const t = state.target === null ? null : gifts[state.target];
  $('upLine').innerHTML = (s && t)
    ? '<span>Апгрейд</span><b>' + esc(s.gift.name) + '</b><span class="arrow">➜</span><img src="' + t.image + '" alt=""><b>' + esc(t.name) + '</b>'
    : '<span>Нет подарка дороже выбранного</span>';
  const btn = $('spinBtn');
  if (!s || !t) {
    btn.disabled = true;
    $('spinSub').textContent = 'Выбери подарок дороже ставки';
  } else {
    btn.disabled = state.spinning;
    $('spinSub').textContent = (s.src === 'nft' ? 'Апгрейдим NFT «' : 'Ставка ⭐ ' + s.gift.price + ' · «') + s.gift.name + '» → ' + t.name;
  }
}
function renderAll() { renderBalance(false); renderPickers(); renderCircle(); if (!state.spinning) idleStrip(); }

function selectStake(key) {
  if (state.spinning) return;
  state.stakeKey = key;
  haptic('impact', 'light');
  renderPickers(); renderCircle();
}
function selectTarget(i) {
  if (state.spinning) return;
  state.target = i;
  haptic('impact', 'light');
  renderPickers(); renderCircle();
}

/* ================= Рулетка ================= */
const STRIP_LEN = 60, WIN_INDEX = 48;
function cardHTML(g) {
  return '<div class="rcard" style="' + colorVars(g.price) + '">' +
    '<img src="' + g.image + '" style="width: 60px; height: 60px; object-fit: contain;">' +
    '<span class="n">' + esc(g.name) + '</span><span class="p">⭐ ' + g.price + '</span></div>';
}
const randGift = (pool) => pool[Math.floor(Math.random() * pool.length)];
function buildStrip(winGift) {
  const strip = $('strip');
  strip.classList.remove('done');
  strip.style.transition = 'none';
  strip.style.transform = 'translateX(0)';
  let out = '';
  for (let i = 0; i < STRIP_LEN; i++) out += cardHTML(i === WIN_INDEX ? winGift : randGift(gifts));
  strip.innerHTML = out;
}
function idleStrip() {
  buildStrip(gifts[0]);
  const strip = $('strip');
  const vw = $('viewport').clientWidth;
  const pitch = strip.children[0].offsetWidth + 8;
  strip.style.transform = 'translateX(' + (-(10 * pitch + pitch / 2 - vw / 2)) + 'px)';
}

function spin() {
  const s = getStake();
  if (state.spinning || !s || state.target === null) return;
  const target = gifts[state.target];

  if (s.src === 'stars') {
    if (state.balance < s.gift.price) {
      showToast('Не хватает звёзд — пополни баланс');
      haptic('notify', 'error');
      openModal('topupModal');
      return;
    }
    state.balance -= s.gift.price;
    renderBalance(true);
  }

  state.spinning = true;
  $('circle').classList.add('spinning');
  renderPickers(); renderCircle();
  $('spinBtn').disabled = true;

  const win = Math.random() * 100 < getChance();
  const landed = win ? target : randGift(gifts.filter(g => g !== target));
  buildStrip(landed);

  const strip = $('strip');
  const vw = $('viewport').clientWidth;
  const pitch = strip.children[0].offsetWidth + 8;
  const jitter = (Math.random() - .5) * (pitch * .7);
  const dist = WIN_INDEX * pitch + pitch / 2 - vw / 2 + jitter;

  void strip.offsetWidth;
  const DURATION = 6200;
  strip.style.transition = 'transform ' + DURATION + 'ms cubic-bezier(.08,.6,.12,1)';
  strip.style.transform = 'translateX(' + (-dist) + 'px)';

  const tick = setInterval(() => haptic('impact', 'light'), 220);
  setTimeout(() => clearInterval(tick), DURATION - 900);
  setTimeout(() => finishSpin(win, s, target, landed), DURATION + 200);
}

function finishSpin(win, s, target, landed) {
  const strip = $('strip');
  strip.classList.add('done');
  strip.children[WIN_INDEX].classList.add('winner');
  $('circle').classList.remove('spinning');
  haptic('notify', win ? 'success' : 'error');

  // Ставленный NFT сгорает; при выигрыше получаем целевой подарок в инвентарь
  if (s.src === 'nft') state.inventory = state.inventory.filter(x => x.uid !== s.uid);
  if (win) {
    const newItem = { uid: uidCounter++, gift: { name: target.name, price: target.price, image: target.image } };
    state.inventory.push(newItem);
    state.stakeKey = 'inv:' + newItem.uid;
  } else if (s.src === 'nft') {
    state.stakeKey = null;
  }
  state.target = null;

  $('resultBox').className = 'modal result ' + (win ? 'win' : 'lose');
  $('resTitle').textContent = win ? 'АПГРЕЙД!' : 'НЕ ПОВЕЗЛО';
  $('resImg').src = landed.image;
  $('resImg').alt = landed.name;
  $('resSub').textContent = win
    ? 'Ты получил «' + target.name + '» вместо «' + s.gift.name + '»'
    : 'Выпало «' + landed.name + '». «' + s.gift.name + '» сгорел';
  setTimeout(() => openModal('resultModal'), 700);

  const payload = { action: 'spin_result', win: win, item: target.name, from: s.gift.name, source: s.src };
  setTimeout(() => sendToBot(payload), 2600);

  state.spinning = false;
  renderBalance(false); renderPickers(); renderCircle();
}

/* ================= Модалки ================= */
function openModal(id) { if (id === 'profileModal') renderBalance(false); $(id).classList.add('open'); }
function closeModal(id) { $(id).classList.remove('open'); }
document.querySelectorAll('.overlay').forEach(ov => {
  ov.addEventListener('click', (e) => { if (e.target === ov) ov.classList.remove('open'); });
});
document.querySelectorAll('[data-close]').forEach(b => b.onclick = () => b.closest('.overlay').classList.remove('open'));
$('userBtn').onclick = () => { haptic('impact', 'light'); openModal('profileModal'); };
$('plusBtn').onclick = () => { haptic('impact', 'light'); openModal('topupModal'); };
$('resClose').onclick = () => { closeModal('resultModal'); idleStrip(); };

/* ================= Пополнение ================= */
let topupAmount = 50;
document.querySelectorAll('.amt').forEach(b => {
  b.onclick = () => {
    topupAmount = +b.dataset.amt;
    document.querySelectorAll('.amt').forEach(x => x.classList.toggle('sel', x === b));
    haptic('impact', 'light');
  };
});
$('topupStars').onclick = () => {
  sendToBot({ action: 'topup', method: 'stars', amount: topupAmount });
  closeApp();
};
$('topupNft').onclick = () => {
  sendToBot({ action: 'topup', method: 'nft' });
  closeApp();
};

/* ================= Тост ================= */
let toastTimer;
function showToast(text) {
  const t = $('toast');
  t.textContent = text;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

/* ================= Старт ================= */
$('spinBtn').onclick = spin;
loadUser();
loadInventory();
renderAll();
window.addEventListener('resize', () => { if (!state.spinning) idleStrip(); });
</script>
</body>
</html>
