  const c=chatById(openId),inp=$('#cvText'),text=inp.value.trim();
  if(!c||!c.ai||!text||busy)return;
  inp.value='';c.msgs.push({from:'me',text,t:now()});c.touched=true;
  busy=true;renderQuick();renderMsgs();
  const myChat=c.id,started=Date.now();
  const reply=await askAI(c);
  const wait=Math.max(0,700-(Date.now()-started));
  setTimeout(()=>{
    c.msgs.push({from:'bot',ai:true,text:reply,t:now()});busy=false;
    if(openId===myChat)renderMsgs();else{c.unread++;renderChats();}
    renderChats();
  },wait);
}

/* Ответ ИИ: сначала сервер (Claude API через server.js), если недоступен — демо-ответы в браузере */
async function askAI(c){
  const history=c.msgs.filter(m=>m.from==='me'||m.from==='bot').slice(-20).map(m=>({role:m.from==='me'?'user':'assistant',content:m.text}));
  if(CONFIG.API_URL){
    try{
      const r=await fetch(CONFIG.API_URL,{method:'POST',headers:{'Content-Type':'application/json','X-Telegram-Init-Data':tg?tg.initData:''},body:JSON.stringify({chat:c.id==='ai'?'assistant':'support',messages:history})});
      if(r.ok){const d=await r.json();if(d&&d.reply)return d.reply;}
    }catch(e){}
  }
  return localAnswer(c.id,history[history.length-1].content);
}
const FAQ=[
  [/оператор|человек|менеджер|живой/i,'Передаю ваш запрос оператору — он подключится к чату в ближайшее время. Пока опишите проблему подробнее и укажите номер заказа.'],
  [/выдач|долго|срок|не пришл|не прихо|не получ/i,'Обычно товар выдаётся за 1–5 минут. Если прошло больше 15 минут, напишите номер заказа и логин, на который покупали — я передам запрос специалисту.'],
  [/возврат|верн|деньги назад/i,'Возврат возможен, если товар не был выдан. Опишите ситуацию и номер заказа, я передам заявку оператору.'],
  [/комисс/i,'Комиссия сервиса — 5% (на экране покупки она показана перед оплатой). С промокодом START в демо-версии комиссия снимается.'],
  [/бонус|кэшб|кешб|очки|баллы/i,'За каждую покупку начисляется 20% бонусами — они копятся в профиле и показаны в правом верхнем углу.'],
  [/гарант|безопас|мошен|надёжн|надежн/i,'Оплата идёт через сервис: деньги продавцу не передаются, пока вы не получите товар.'],
  [/промокод/i,'Промокод вводится на экране покупки — кнопка «Ввести промокод» под полем суммы.'],
  [/оплат|карт|сбп|платеж|платёж/i,'Оплатить можно банковской картой, через СБП и международными картами. Нажмите «Оплатить» на экране покупки.'],
  [/как.*(куп|пополн)|купить|пополнить|робукс|\buc\b|звёзд|звезд|подписк/i,'Выберите игру на главной или в поиске, введите логин и сумму и нажмите «Оплатить». Выдача автоматическая.'],
  [/привет|здравств|добр|хай/i,'Здравствуйте! Чем могу помочь?']
];
function localAnswer(chatId,text){
  for(const [re,ans] of FAQ)if(re.test(text))return ans;
  return chatId==='support'?'Уточните, пожалуйста, что именно произошло и номер заказа — я разберусь или передам оператору.':'Могу рассказать про выбор товара, оплату, комиссию, выдачу и бонусы. Спросите чуть конкретнее.';
}

/* ================= НАВИГАЦИЯ ================= */
const NAV=[['search','search','Поиск'],['home','prize','Призы'],['sell','sell','Продать'],['chats','chats','Чаты'],['profile',null,'Профиль']];
const profileAv=()=>{const p=tgUser&&tgUser.photo_url;return p?`<div class="ni navav"><img src="${esc(p)}" alt=""></div>`:`<div class="ni navav">${svgWrap(`<circle cx="50" cy="50" r="50" fill="#5A7A52"/><circle cx="50" cy="38" r="17" fill="#EBC9A4"/><path d="M16 94Q16 62 50 62Q84 62 84 94Z" fill="#E8EEE0"/><path d="M33 34Q36 16 52 17Q66 18 67 34Q58 26 33 34Z" fill="#6B4A2B"/>`)}</div>`;};
$('#nav').innerHTML=NAV.map(n=>`<button data-s="${n[0]}" class="${n[0]==='home'?'prize':''}">${n[1]?`<div class="ni">${svgWrap(NI[n[1]])}${n[0]==='chats'?'<i class="rd"></i>':''}</div>`:profileAv()}${n[2]}</button>`).join('');
function go(s){
  document.querySelectorAll('.screen').forEach(e=>e.classList.toggle('on',e.id==='s-'+s));
  document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('on',b.dataset.s===s&&s!=='home'));
  if(s==='search')renderServices($('#q2').value);
  if(s==='chats')renderChats();
  if(openId)closeChat();
  window.scrollTo(0,0);
}
$('#nav').addEventListener('click',e=>{const b=e.target.closest('button');if(b)go(b.dataset.s);});

/* 3D-наклон иконок */
document.addEventListener('pointermove',e=>{const t=e.target.closest&&e.target.closest('.tilt');if(!t)return;const r=t.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;t.style.setProperty('--ry',((x-.5)*30)+'deg');t.style.setProperty('--rx',((.5-y)*30)+'deg');t.style.setProperty('--mx',x*100+'%');t.style.setProperty('--my',y*100+'%');});
['pointerout','pointerup','pointercancel'].forEach(ev=>document.addEventListener(ev,e=>{const t=e.target.closest&&e.target.closest('.tilt');if(t){t.style.setProperty('--rx','0deg');t.style.setProperty('--ry','0deg');}}));

renderCur();selectCat('steam');updateBalance();renderChats();renderServices();go('home');
